# ========= Telegram =========
TELEGRAM_BOT_TOKEN=
# 单用户白名单：你自己的 chat id（整数，和 bot 聊一句随便发 /start，后台会打印）
TELEGRAM_ALLOWED_CHAT_ID=
# 访问 api.telegram.org 需要的代理（国内环境必填；境外留空）。示例：http://127.0.0.1:7897
TELEGRAM_PROXY=

# ========= MiniMax =========
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# OpenAI 兼容 base，末尾不要加 /
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 聊天模型（按你手头 key 的权限改，例：MiniMax-M2 / abab6.5s-chat）
MINIMAX_CHAT_MODEL=MiniMax-M2
# embedding 模型
MINIMAX_EMBED_MODEL=embo-01

# ========= LLM 选型（主聊天/情绪判档/话题抽取；memU 内部仍走 MiniMax） =========
LLM_PROVIDER=minimax         # minimax | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_AUX=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=

# ========= memU =========
# 第一版：inmemory（重启丢记忆）
# 第二版：postgresql+psycopg://postgres:postgres@localhost:5432/memu
MEMU_METADATA_PROVIDER=inmemory
MEMU_DB_URL=

# ========= 本地 Embedding 服务 =========
# memU 要 OpenAI 兼容 embedding endpoint，但 MiniMax embedding 不兼容。
# 这里用本地 sentence-transformers 起一个小 server，零成本。
EMBED_SERVER_HOST=127.0.0.1
EMBED_SERVER_PORT=18080
EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ========= 业务参数 =========
# 距最后一次交互多久后允许主动搭话（秒）
PROACTIVE_IDLE_THRESHOLD_SEC=21600
# 兴趣热度衰减时间常数（小时）
INTEREST_DECAY_TAU_HOURS=48
# 本地 SQLite 路径
APP_DB_PATH=./data/app.sqlite
