# ========= Telegram =========
TELEGRAM_BOT_TOKEN=
# 单用户白名单：你自己的 chat id（整数，和 bot 聊一句随便发 /start，后台会打印）
TELEGRAM_ALLOWED_CHAT_ID=
# 访问 api.telegram.org 需要的代理（国内环境必填；境外留空）。示例：http://127.0.0.1:7897
TELEGRAM_PROXY=

# ========= MiniMax =========
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# OpenAI 兼容 base，末尾不要加 /
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 聊天模型（按你手头 key 的权限改，例：MiniMax-M2 / abab6.5s-chat）
MINIMAX_CHAT_MODEL=MiniMax-M2
# embedding 模型
MINIMAX_EMBED_MODEL=embo-01

# ========= LLM 选型（主聊天 / 情绪判档 / 话题抽取） =========
# openrouter（默认推荐）/ minimax / anthropic
LLM_PROVIDER=openrouter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_AUX=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

# OpenRouter（LLM_PROVIDER=openrouter 用）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_AUX=

# 自搭记忆栈：抽取模型（OpenAI 兼容；走 OpenRouter）
MEMU_CHAT_MODEL=deepseek/deepseek-v4-flash

# ========= 记忆栈（自搭，沿用旧 env 名）=========
# postgres 连接串（有 pgvector 扩展即可）。空 = 启动报错——记忆栈是必需的。
MEMU_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/memu

# ========= 本地 Embedding 服务 =========
# 记忆 RAG 用的本地 sentence-transformers 服务。
EMBED_SERVER_HOST=127.0.0.1
EMBED_SERVER_PORT=18080
EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ========= 业务参数 =========
# 距最后一次交互多久后允许主动搭话（秒）
PROACTIVE_IDLE_THRESHOLD_SEC=21600
# 兴趣热度衰减时间常数（小时）
INTEREST_DECAY_TAU_HOURS=48
# 本地 SQLite 路径
APP_DB_PATH=./data/app.sqlite

# ========= Jina Reader =========
# 网页正文读取。空 → 匿名（容易被 401 风控）；建议注册免费 key：https://jina.ai/reader/
JINA_API_KEY=

# ========= Admin UI 鉴权 =========
# 公开 admin UI 时**必填**——设了就启用 HTTP Basic Auth；两个都空则不鉴权（仅本地开发）
ADMIN_UI_USER=
ADMIN_UI_PASSWORD=

# ========= 测试 bot（多用户模拟）=========
# 可选：第二个 bot token；启用后用户在测试 bot 里 /become <label> 选虚拟身份
# 同 telegram 账户能扮演不同 user_id，测多用户隔离不需要多个 telegram 号
TEST_BOT_TOKEN=
